def style(widget, name):
    widget.get_style_context().add_class(name)
    return widget


def label(text, css=None):
    widget = Gtk.Label(label=text)
    return style(widget, css) if css else widget


def change_style(widget, name, enabled):
    context = widget.get_style_context()
    if enabled:
        context.add_class(name)
    else:
        context.remove_class(name)


class Glyph(Gtk.DrawingArea):
    def __init__(self, name, size=17):
        super().__init__()
        self.name = name
        self.size = size
        self.set_size_request(size, size)
        self.connect("draw", self.draw_glyph)

    def draw_glyph(self, _widget, cr):
        x = (self.get_allocated_width() - self.size) / 2
        y = (self.get_allocated_height() - self.size) / 2
        cr.translate(x, y)
        if self.name == "brand":
            emblem(cr, self.size)
        elif isinstance(self.name, tuple):
            rounded(cr, 1, 1, self.size - 2, self.size - 2, 4)
            color = (.35, .35, .35) if self.get_state_flags() & Gtk.StateFlags.INSENSITIVE else self.name
            cr.set_source_rgb(*color)
            cr.fill_preserve()
            cr.set_source_rgba(1, 1, 1, .24)
            cr.set_line_width(1)
            cr.stroke()
        else:
            context = self.get_style_context()
            color = context.get_color(self.get_state_flags())
            cr.set_source_rgba(color.red, color.green, color.blue, color.alpha)
            icon(cr, self.name, 0, 0, self.size)
        return False


def button(name, text, callback=None, *, css="command", tooltip=None, menu=False,
           disclosure=False):
    widget = Gtk.MenuButton() if menu else Gtk.Button()
    style(widget, css)
    row = Gtk.Box(spacing=5)
    if name:
        row.pack_start(Glyph(name), False, False, 0)
    if text:
        row.pack_start(label(text), False, False, 0)
    if disclosure:
        row.pack_end(Glyph("down", 11), False, False, 0)
    widget.add(row)
    if tooltip or text:
        widget.set_tooltip_text(tooltip or text)
        widget.get_accessible().set_name(tooltip or text)
    if callback:
        widget.connect("clicked", lambda *_: callback())
    return widget


def divider(row):
    row.pack_start(Gtk.Separator(orientation=Gtk.Orientation.VERTICAL), False, False, 1)


def popover(anchor, title):
    popup = style(Gtk.Popover.new(anchor), "still-popover")
    anchor.set_popover(popup)
    content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2, margin=6)
    heading = label(title, "menu-heading")
    heading.set_xalign(0)
    content.pack_start(heading, False, False, 0)
    popup.add(content)
    content.show_all()
    return popup, content


def menu_item(content, popup, name, text, callback):
    def select():
        popup.popdown()
        callback()

    item = button(name, text, select, css="menu-row")
    item.set_halign(Gtk.Align.FILL)
    item.get_child().set_halign(Gtk.Align.START)
    content.pack_start(item, False, False, 0)
    item.show_all()
    return item


